{
  "name": "main-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "NEXT_DIST_DIR=.next-test node scripts/test-db.mjs next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma db execute --file prisma/sql/lockdown.sql",
    "db:deploy": "prisma migrate deploy && prisma db execute --file prisma/sql/lockdown.sql",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node scripts/test-db.mjs tsx prisma/seed-demo.ts",
    "db:test:deploy": "node scripts/test-db.mjs npm run db:deploy",
    "db:prod:deploy": "node scripts/prod-db.mjs npm run db:deploy",
    "db:prod:seed": "node scripts/prod-db.mjs tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && prisma db execute --file prisma/sql/lockdown.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
