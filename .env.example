# Copy to `.env.local` for development, and set the same values in your deploy.
# Never commit the filled-in file — `.gitignore` already covers `.env*`.

# Supabase — required. Both values are on the project's API settings page:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. When set, POST /api/demo-request writes as the service
# role, which bypasses row-level security — the `demo_requests` table then needs
# no public insert policy (see docs/handoff/bus-buddy/demo-requests.sql). It is
# also what signs document upload and download URLs in Supabase Storage.
# Never prefix this with NEXT_PUBLIC_: that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — required for the three apps. Supabase dashboard → Connect → ORMs.
# DATABASE_URL is the pooled connection the app uses (port 6543, transaction
# mode). DIRECT_URL is the session connection migrations need (port 5432).
DATABASE_URL=
DIRECT_URL=

# Tests run against a separate database; they truncate it. Never point this at
# the database above.
DATABASE_URL_TEST=

# Development only. When 1, the parent OTP and the admin password-reset link
# come back in the API response so you can sign in without SMS or email.
# Leave it unset in production.
DEV_ECHO_SECRETS=
